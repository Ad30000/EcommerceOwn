@model CloudAndCO.Models.Order

@{
    ViewData["Title"] = "Order Details";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container">
    <h2>Order Details - Order #@Model.OrderId</h2>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">
            @TempData["SuccessMessage"]
        </div>
    }

    <div class="row">
        <div class="col-md-6">
            <h4>Order Information</h4>
            <dl class="row">
                <dt class="col-sm-4">Order ID:</dt>
                <dd class="col-sm-8">@Model.OrderId</dd>

                <dt class="col-sm-4">Customer:</dt>
                <dd class="col-sm-8">@Model.Customer?.Name @Model.Customer?</dd>

                <dt class="col-sm-4">Order Date:</dt>
                <dd class="col-sm-8">@Model.OrderDate.ToString("yyyy-MM-dd HH:mm")</dd>

                <dt class="col-sm-4">Total Amount:</dt>
                <dd class="col-sm-8">@Model.TotalAmount.ToString("C")</dd>

                <dt class="col-sm-4">Status:</dt>
                <dd class="col-sm-8">
                    <span class="badge badge-@(Model.Status == "PROCESSED" ? "success" : "warning")">
                        @Model.Status
                    </span>
                </dd>
            </dl>
        </div>
    </div>

    <!-- Status Update Section -->
    <div class="row mt-3">
        <div class="col-md-6">
            <div class="card">
                <div class="card-header">
                    <h5 class="card-title mb-0">Update Order Status</h5>
                </div>
                <div class="card-body">
                    @if (Model.Status != "PROCESSED")
                    {
                        <a href="@Url.Action("MarkAsProcessed", "Admin", new { id = Model.OrderId })"
                           class="btn btn-success btn-lg btn-block"
                           onclick="return confirm('Mark order #@Model.OrderId as PROCESSED?')">
                            Mark as PROCESSED
                        </a>
                    }
                    else
                    {
                        <p class="text-success">
                            <i class="fas fa-check-circle"></i> This order has been processed.
                        </p>
                    }

                    <a href="@Url.Action("UpdateOrderStatus", "Admin", new { id = Model.OrderId })"
                       class="btn btn-outline-primary btn-block mt-2">
                        Other Status Options
                    </a>
                </div>
            </div>
        </div>
    </div>

    <div class="mt-3">
        <a href="@Url.Action("ViewOrders", "Admin")" class="btn btn-secondary">Back to Orders</a>
    </div>
</div>
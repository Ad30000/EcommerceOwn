@model IEnumerable<CloudAndCO.Models.Order>

@{
    ViewData["Title"] = "View Orders";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container">
    <h2>All Orders</h2>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (Model != null && Model.Any())
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover">
                <thead class="table-dark">
                    <tr>
                        <th>Order ID</th>
                        <th>Customer</th>
                        <th>Order Date</th>
                        <th>Total Amount</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var order in Model)
                    {
                        <tr>
                            <td>@order.OrderId</td>
                            <td>@order.Customer?.Name</td>
                            <td>@order.OrderDate.ToString("yyyy-MM-dd HH:mm")</td>
                            <td>@order.TotalAmount.ToString("C")</td>
                            <td>
                                <span class="badge bg-@(order.Status == "PROCESSED" ? "success" :
                                                                                           order.Status == "PENDING" ? "warning" :
                                                                                           order.Status == "SHIPPED" ? "primary" :
                                                                                           order.Status == "DELIVERED" ? "info" :
                                                                                           order.Status == "CANCELLED" ? "danger" : "secondary")">
                            @order.Status
                        </span>
                    </td>
                    <td>
                        <div class="btn-group" role="group">
                            <a href="@Url.Action("OrderDetails", "Admin", new { id = order.OrderId })"
                               class="btn btn-info btn-sm">
                                <i class="fas fa-eye"></i> Details
                            </a>

                                    <!-- Mark as Processed - Show for PENDING status -->
                            @if (order.Status == "PENDING" || order.Status == "Placed")
                                    {
                                        <a href="@Url.Action("MarkAsProcessed", "Admin", new { id = order.OrderId })"
                                           class="btn btn-success btn-sm"
                                           onclick="return confirm('Mark order #@order.OrderId as PROCESSED?')">
                                            <i class="fas fa-check"></i> Process
                                        </a>
                                    }

                                    <!-- Mark as Shipped - Show for PROCESSED status -->
                                    @if (order.Status == "PROCESSED")
                                    {
                                        <a href="@Url.Action("MarkAsShipped", "Admin", new { id = order.OrderId })"
                                           class="btn btn-primary btn-sm"
                                           onclick="return confirm('Mark order #@order.OrderId as SHIPPED?')">
                                            <i class="fas fa-shipping-fast"></i> Ship
                                        </a>
                                    }

                                    <!-- Mark as Delivered - Show for SHIPPED status -->
                                    @if (order.Status == "SHIPPED")
                                    {
                                        <a href="@Url.Action("MarkAsDelivered", "Admin", new { id = order.OrderId })"
                                           class="btn btn-info btn-sm"
                                           onclick="return confirm('Mark order #@order.OrderId as DELIVERED?')">
                                            <i class="fas fa-box-open"></i> Deliver
                                        </a>
                                    }

                                    <!-- Cancel Order - Show for non-final statuses -->
                                    @if (order.Status != "DELIVERED" && order.Status != "CANCELLED")
                                    {
                                        <a href="@Url.Action("CancelOrder", "Admin", new { id = order.OrderId })"
                                           class="btn btn-danger btn-sm"
                                           onclick="return confirm('Cancel order #@order.OrderId? This action cannot be undone.')">
                                            <i class="fas fa-times"></i> Cancel
                                        </a>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="alert alert-info">
            <i class="fas fa-info-circle"></i> No orders found.
        </div>
    }
</div>

@section Scripts {
    <script>
        // Auto-dismiss alerts after 5 seconds
        setTimeout(function() {
            $('.alert').alert('close');
        }, 5000);
    </script>
}